{% extends 'base.html.twig' %}

{% block title %}Validation des événements{% endblock %}

{% block body %}
<div class="container">
    <h1>Validation des événements</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% if events is empty %}
        <p>Aucun événement en attente de validation.</p>
    {% else %}
        <table class="table">
            <thead>
                <tr>
                    <th>Événement</th>
                    <th>Date</th>
                    <th>Catégorie</th>
                    <th>Places</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for event in events %}
                    <tr>
                        <td>{{ event.titre }}</td>
                        <td>{{ event.date ? event.date|date('d/m/Y H\\h00') : '' }}</td>
                        <td><span class="badge">{{ event.categorie }}</span></td>
                        <td>{{ event.nombreDePlace }}</td>
                        <td><span class="badge badge-warning">Non validé</span></td>
                        <td>
                            <a href="{{ path('app_event_validate_action', {'id': event.id}) }}" class="btn btn-success">Valider</a>
                            <a href="{{ path('app_event_delete_action', {'id': event.id}) }}" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?');">Supprimer</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}